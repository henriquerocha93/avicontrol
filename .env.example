# ==========================================
# FIREBASE DATABASE & AUTH CONFIGURATION
# ==========================================
# Obtenha estas credenciais no Firebase Console (Configurações do Projeto > Geral > Seus aplicativos > SDK Web):
# https://console.firebase.google.com/
NEXT_PUBLIC_FIREBASE_API_KEY=sua_api_key_aqui
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=seu-projeto.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=seu-projeto-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=seu-projeto.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000
NEXT_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:00000000000000
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# ==========================================
# BIRDPRO AI CONFIGURATION (Opcional)
# ==========================================
# Para conectar o BIRDPRO AI com Google Gemini:
GEMINI_API_KEY=sua_chave_gemini_aqui

# ==========================================
# SEO & GOOGLE SEARCH CONSOLE CONFIGURATION
# ==========================================
NEXT_PUBLIC_APP_URL=https://www.birdpro.com.br
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=seu_codigo_de_verificacao_google_aqui
